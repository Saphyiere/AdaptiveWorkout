@* The workout's masthead: its name, time and a tally of the sets done, the view switch, and Finish, which is always reachable.
   Its rule is in the pen's color while the workout is live. *@
@inject AppNavigation Navigation
@{ var setsDone = State.Sets.Count(s => s.StoppedAt is not null); }
<header class="masthead live">
    <div class="spread">
        @if (Theme == Theme.Telemetry)
        {
            @* A live channel: the workout's name and LIVE, then mission time since Start. *@
            <div class="row-text">
                <p class="inline"><span class="title workout">@State.Name</span><span class="chip live">Live</span></p>
                <span class="caption">T+<Clock Since="State.Session.StartedAt" /> · @setsDone @(setsDone == 1 ? "set" : "sets")</span>
            </div>
        }
        else
        {
            <div class="row-text">
                <p class="title workout">@State.Name</p>
                <span class="inline">
                    <span class="caption"><Clock Since="State.Session.StartedAt" /> · @setsDone @(setsDone == 1 ? "set" : "sets")</span>
                    @if (setsDone is > 0 and <= 25)
                    {
                        <Mark Kind="MarkKind.Tally" Count="setsDone" Size="16" />
                    }
                </span>
            </div>
        }
        <div class="inline">
            @if (Advanced)
            {
                <a class="icon-btn" href="workout" aria-label="Simple view" @onclick="@(() => Navigation.Replace("workout"))" @onclick:preventDefault><Icon Name="page" Size="22" /></a>
            }
            else
            {
                <a class="icon-btn" href="workout/advanced" aria-label="Advanced view" @onclick="@(() => Navigation.Replace("workout/advanced"))" @onclick:preventDefault><Icon Name="list" Size="22" /></a>
            }
            <button type="button" class="btn" @onclick="() => confirming = true">Finish</button>
        </div>
    </div>
</header>

@if (confirming)
{
    <div class="block appear">
        <p class="name big">Finish this workout?</p>
        <div class="grid-2">
            <button type="button" class="btn tall" @onclick="() => confirming = false">Keep going</button>
            <button type="button" class="btn tall fill" @onclick="OnFinish">Finish workout</button>
        </div>
    </div>
}

@code {
    private bool confirming;

    [CascadingParameter] public Theme Theme { get; set; } = Theme.Logbook;

    [Parameter, EditorRequired] public WorkoutState State { get; set; } = default!;
    [Parameter] public bool Advanced { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }

    // The workout's other screens name it on their way back. Its two views take each other's place rather than stacking up.
    protected override void OnParametersSet() => Navigation.Name(State.Name);
}
