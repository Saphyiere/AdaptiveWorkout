@* A screen's masthead: the way back, a small label, the title, and the rule under them, with any tools (like Settings) at the right. *@
<header class="masthead @(Live ? "live" : "")">
    @if (Back is not null)
    {
        <a class="back" href="@Back"><Icon Name="arrow-left" Size="22" /><span>@BackText</span></a>
    }
    <div class="masthead-main">
        <div class="masthead-text">
            @if (Label is not null)
            {
                <p class="label">@Label</p>
            }
            <h1 class="title @(Small ? "small" : "")">@Title</h1>
        </div>
        @Tools
    </div>
</header>

@code {
    /// <summary>Where the way back goes; none on Today.</summary>
    [Parameter] public string? Back { get; set; }

    [Parameter] public string BackText { get; set; } = "Back";
    [Parameter] public string? Label { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>A smaller title, for screens a step below the main ones.</summary>
    [Parameter] public bool Small { get; set; }

    /// <summary>A screen inside a running workout: its rule is in the pen's color, like the workout's own masthead.</summary>
    [Parameter] public bool Live { get; set; }

    /// <summary>Buttons or links at the right of the title.</summary>
    [Parameter] public RenderFragment? Tools { get; set; }
}
