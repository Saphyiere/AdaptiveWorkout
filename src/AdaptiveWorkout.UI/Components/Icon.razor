@* Plain line icons: thin strokes with round caps and joins. Only the pen marks (Mark.razor) look hand-made. *@
<svg aria-hidden="true" viewBox="0 0 24 24" width="@Size" height="@Size">
    <path d="@PathData" fill="none" stroke="@Color" stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Stroke { get; set; } = 1.5;

    private string PathData => Name switch
