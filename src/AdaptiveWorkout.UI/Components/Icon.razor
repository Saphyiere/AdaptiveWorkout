@* Thin line icons with sharp joins, to match the mark. *@
<svg aria-hidden="true" viewBox="0 0 24 24" width="@Size" height="@Size">
    <path d="@PathData" fill="none" stroke="@Color" stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="miter" stroke-miterlimit="12"></path>
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Stroke { get; set; } = 1.5;

    private string PathData => Name switch
    {
        "back" => "M15 5L8 12L15 19",
        "forward" => "M9 5L16 12L9 19",
        "plus" => "M12 5V19M5 12H19",
        "minus" => "M5 12H19",
        "close" => "M6 6L18 18M18 6L6 18",
        "check" => "M5 12.5L10 17.5L19 7",
        "up" => "M6 15L12 9L18 15",
        "down" => "M6 9L12 15L18 9",
        "edit" => "M4 20H8L19 9L15 5L4 16Z",
        "mark" => "M3 15H9L12 4L15 20L17 11H21",
        "trash" => "M4 7H20M9 7V4H15V7M6 7L7 20H17L18 7M10 11V16M14 11V16",
        _ => "",
    };
}
