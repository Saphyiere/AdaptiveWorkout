@inject WorkoutFlow Flow
@inject AppSettings Settings
@* One stopped set on the rest screen: weight, reps and Hit goal, pre-filled. Save (or Enter) tucks it into today's summary. *@

@{
    var exercise = State.Exercises[Set.ExerciseId];
    var id = $"set-{Set.Order}";
    var unit = Set.WeightUnit == WeightUnit.Kilograms ? "kg" : "lb";
}
<form class="block appear" aria-labelledby="@id-heading" @onsubmit="SaveAsync">
    <h2 id="@id-heading" class="label">@exercise.Name · @WorkoutState.StepLabel(State.Describe(Set))</h2>
    <div class="entry-row">
        <div class="field-group entry-weight">
            <label class="field-label" for="@id-weight">Weight</label>
            <div class="writing">
                <input id="@id-weight" class="field number-field" type="number" inputmode="decimal" step="any" placeholder="Bodyweight" @bind="Set.Weight" @bind:after="() => Flow.SaveSet(Set)" />
                <span class="unit">@unit</span>
            </div>
        </div>
        <div class="field-group entry-reps">
            <label class="field-label" for="@id-reps">Reps</label>
            <div class="writing">
                <input id="@id-reps" class="field number-field" type="number" inputmode="numeric" min="0" @bind="Set.Reps" @bind:after="() => Flow.SaveSet(Set)" />
            </div>
        </div>
        <label class="goal">
            <input type="checkbox" @bind="Set.HitGoal" @bind:after="() => Flow.SaveSet(Set)" />
            <span>Hit goal</span>
        </label>
    </div>
    <div class="spread">
        <p class="note">@(Set.Weight is double weight ? $"Hit goal: next time starts at {SetSummary.WeightText(weight + Settings.HitGoalStep)} {unit}" : "Bodyweight stays bodyweight")</p>
        <div class="inline">
            <button type="button" class="btn tall" aria-label="Switch between added and assisted weight" disabled="@(Set.Weight is null)" @onclick="() => { Set.Weight = -Set.Weight; Flow.SaveSet(Set); }">+/−</button>
            <button type="submit" class="btn tall adjust">Save</button>
        </div>
    </div>
</form>

@code {
    [Parameter, EditorRequired] public WorkoutState State { get; set; } = default!;
    [Parameter, EditorRequired] public WorkoutSet Set { get; set; } = default!;

    /// <summary>Called after Save, so the rest screen re-renders without this entry.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private Task SaveAsync()
    {
        Flow.ConfirmSet(Set);
        return OnSaved.InvokeAsync();
    }
}
