@inject WorkoutFlow Flow
@inject AppNavigation Navigation
@* The break screen's buttons: the next set or exercise, and Finish once there's nothing left to do. A planned cool-down starts in
   Finish's place, and Finish ends it. During the warm-up, the big button starts the first exercise. *@

@if (State.CoolingDown)
{
    <button type="button" class="btn-primary save" @onclick="OnFinish">Finish workout</button>
}
else if (State.Next is { } next)
{
    // Going on with what I just did reads "Start set 3" (or round); anything else, its name.
    var goingOn = State.LastRound.Select(s => s.ExerciseId).SequenceEqual(next.ExerciseIds);
    var names = State.Names(next.ExerciseIds);
    @if (State.Plan.Count > 0 && next.IsRound)
    {
        @* A superset's round: each of its exercises can be changed on its own. *@
        <div class="stack tight next-step">
            <p class="label">Next · @WorkoutState.StepLabel(next)</p>
            @foreach (var exerciseId in next.ExerciseIds)
            {
                <div class="spread">
                    <p class="body">@State.Exercises[exerciseId].Name</p>
                    <a class="btn-ghost" href="workout/change?exercise=@exerciseId" aria-label="Change @State.Exercises[exerciseId].Name">Change</a>
                </div>
            }
        </div>
    }
    else if (State.Plan.Count > 0)
    {
        <div class="spread next-step">
            <div class="row-text">
                <p class="label">Next</p>
                <p class="body">@names, @WorkoutState.StepLabel(next).ToLowerInvariant()</p>
            </div>
            <a class="btn-ghost" href="workout/change">Change</a>
        </div>
    }
    else
    {
        <p class="note center">Next: @names, @WorkoutState.StepLabel(next).ToLowerInvariant()</p>
    }

    @* Other ways on sit above the big button, which stays in the same place on every screen. *@
    @if (State.Plan.Count == 0)
    {
        <div class="grid-2">
            <button type="button" class="btn tall" @onclick="@(() => Navigation.Open("workout/exercise"))">Different exercise</button>
            <button type="button" class="btn tall" @onclick="FinishAsync">@FinishText</button>
        </div>
    }
    else if (State is { CanMoveOn: true, MoveOn: { } moveOn })
    {
        <button type="button" class="btn tall" @onclick="() => Start(moveOn)">Move on to @State.Names(moveOn.ExerciseIds)</button>
    }
    else if (State.CanMoveOn)
    {
        <div class="grid-2">
            <a class="btn tall" href="workout/add">Add more</a>
            <button type="button" class="btn tall" @onclick="FinishAsync">@FinishText</button>
        </div>
    }
    else if (!goingOn && CanGoOn)
    {
        <button type="button" class="btn tall" @onclick="StartAnotherAsync">@(State.LastRound is [var only] ? $"Another set of {State.Exercises[only.ExerciseId].Name}" : "Another round")</button>
    }
    <button type="button" class="btn-primary go" @onclick="() => Start(next)">@(goingOn ? $"Start {(next.IsRound ? "round" : "set")} {next.SetNumber}" : $"Start {names}")</button>
}
else if (State.WarmingUp)
{
    <button type="button" class="btn-primary go" @onclick="@(() => Navigation.Open("workout/exercise"))">Pick an exercise</button>
}
else
{
    <p class="note center">@(State.StillToDo().Count == 0 ? "Every planned exercise is done." : "That's the end of the plan.")</p>
    @if (CanGoOn)
    {
        <div class="grid-2">
            <button type="button" class="btn tall" @onclick="StartAnotherAsync">@(State.LastRound.Count > 1 ? "Another round" : "Another set")</button>
            <a class="btn tall" href="workout/add">Add more</a>
        </div>
    }
    else
    {
        <a class="btn tall" href="workout/add">Add more</a>
    }
    <button type="button" class="btn-primary @(State.CoolDownNext ? "go" : "save")" @onclick="FinishAsync">@FinishText</button>
}

@code {
    [Parameter, EditorRequired] public WorkoutState State { get; set; } = default!;

    /// <summary>Called after a set or the cool-down starts, so the page re-renders.</summary>
    [Parameter] public EventCallback OnStarted { get; set; }

    [Parameter] public EventCallback OnFinish { get; set; }

    private string FinishText => State.CoolDownNext ? "Start cool-down" : "Finish workout";

    // More of what I just did, past its sets, while its exercises are still in today's plan.
    private bool CanGoOn => State.LastRound is [_, ..] round && round.All(s => State.Plan.Any(e => e.ExerciseId == s.ExerciseId));

    private Task Start(PlanStep step)
    {
        Flow.StartSets(step.ExerciseIds);
        return OnStarted.InvokeAsync();
    }

    private Task StartAnotherAsync()
    {
        Flow.StartAnother();
        return OnStarted.InvokeAsync();
    }

    // With a cool-down planned, finishing starts it instead.
    private Task FinishAsync()
    {
        if (!State.CoolDownNext) return OnFinish.InvokeAsync();

        Flow.StartCoolDown();
        return OnStarted.InvokeAsync();
    }
}
