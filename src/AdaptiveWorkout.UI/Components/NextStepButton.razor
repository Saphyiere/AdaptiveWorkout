@inject WorkoutFlow Flow
@inject NavigationManager Nav
@* The break screen's buttons: the next set or exercise, and Finish once there's nothing left to do. *@

@if (State.Next is { } next)
{
    var exercise = State.Exercises[next.ExerciseId];
    var sameExercise = State.ToLog?.ExerciseId == next.ExerciseId;
    @if (State.Plan.Count > 0)
    {
        <div class="spread">
            <div class="row-text">
                <p class="label">Next</p>
                <p class="body">@exercise.Name, @WorkoutState.StepLabel(next).ToLowerInvariant()</p>
            </div>
            <a class="btn-ghost" href="workout/change">Change</a>
        </div>
    }
    else
    {
        <p class="note center">Next: @exercise.Name, @WorkoutState.StepLabel(next).ToLowerInvariant()</p>
    }

    @* Other ways on sit above the big button, which stays in the same place on every screen. *@
    @if (State.Plan.Count == 0)
    {
        <div class="grid-2">
            <button type="button" class="btn tall" @onclick="@(() => Nav.NavigateTo("workout/exercise"))">Different exercise</button>
            <button type="button" class="btn tall" @onclick="OnFinish">Finish workout</button>
        </div>
    }
    else if (State.CanMoveOn && State.MoveOn is { } moveOn)
    {
        var after = State.Exercises[moveOn.ExerciseId];
        <button type="button" class="btn tall" @onclick="() => Start(after)">Move on to @after.Name</button>
    }
    else if (State.CanMoveOn)
    {
        <div class="grid-2">
            <a class="btn tall" href="workout/add">Add more</a>
            <button type="button" class="btn tall" @onclick="OnFinish">Finish workout</button>
        </div>
    }
    <button type="button" class="btn-primary go" @onclick="() => Start(exercise)">@(sameExercise ? $"Start set {next.SetNumber}" : $"Start {exercise.Name}")</button>
}
else
{
    <p class="note center">Every planned exercise is done.</p>
    <a class="btn tall" href="workout/add">Add more</a>
    <button type="button" class="btn-primary save" @onclick="OnFinish">Finish workout</button>
}

@code {
    [Parameter, EditorRequired] public WorkoutState State { get; set; } = default!;

    /// <summary>Called after a set starts, so the page re-renders.</summary>
    [Parameter] public EventCallback OnStarted { get; set; }

    [Parameter] public EventCallback OnFinish { get; set; }

    private Task Start(Exercise exercise)
    {
        Flow.StartSet(exercise);
        return OnStarted.InvokeAsync();
    }
}
