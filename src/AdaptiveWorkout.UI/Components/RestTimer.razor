@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WorkoutFlow Flow
@inject WatchLink Watch
@inject WorkoutNotice Notice
@inject IJSRuntime JS
@*
    The rest time. It counts up; tapped, it counts down from this exercise's rest instead, and at zero the next set starts.
    The watch buzzes at zero; the phone buzzes only when no watch is sending heart rate.
*@

@{
    var countdown = Flow.RestCountdown;
    var target = Flow.RestTarget(ExerciseId);
    var elapsed = DateTimeOffset.Now - Since;
    var left = target - elapsed;
    var lastSeconds = countdown && left <= TimeSpan.FromSeconds(10);
}
<div class="spread">
    <h2 class="label">Rest</h2>
    <span class="note">@(countdown ? "counting down" : "counting up")</span>
</div>
<button type="button" class="rest-time" aria-label="@(countdown ? "Rest countdown. Tap to count up instead." : "Rest time. Tap to count down to the next set.")" @onclick="() => Flow.SetRestCountdown(!countdown)">
    <span class="rest-label">Rest</span>
    <span class="number lg @(lastSeconds ? "live" : "")">@(countdown ? left >= TimeSpan.Zero ? TimeText.Format(left) : $"+{TimeText.Format(-left)}" : TimeText.Format(elapsed))</span>
</button>
@if (countdown)
{
    var share = Math.Clamp(left / target, 0, 1);
    <div class="stack tight">
        <div class="time-left @(lastSeconds ? "live" : "")" role="progressbar" aria-label="@($"Rest left, {TimeText.Format(left)} of {TimeText.Format(target)}")" aria-valuemin="0" aria-valuemax="@((int)target.TotalSeconds)" aria-valuenow="@((int)Math.Max(0, left.TotalSeconds))">
            <span style="width: @((share * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
        </div>
        <span class="caption center-end">@TimeText.Format(target)</span>
    </div>
    <div class="inline">
        <button type="button" class="btn tall adjust" aria-label="15 seconds less" @onclick="() => Flow.AdjustRestTarget(ExerciseId, -15)">−15s</button>
        <p class="note grow center"><span class="ink">@TimeText.Format(target)</span>@(NextName is null ? " rest" : $", then {NextName}")</p>
        <button type="button" class="btn tall adjust" aria-label="15 seconds more" @onclick="() => Flow.AdjustRestTarget(ExerciseId, 15)">+15s</button>
    </div>
}
else if (Flow.RestCountdownUntried)
{
    <p class="note">Tap the time to count down to the next set instead.</p>
}

@code {
    private readonly CancellationTokenSource stop = new();
    private IJSObjectReference? alerts;
    private bool seenRunning;
    private bool done;

    [Parameter, EditorRequired] public DateTimeOffset Since { get; set; }

    /// <summary>The exercise just done; the countdown is its rest.</summary>
    [Parameter, EditorRequired] public long ExerciseId { get; set; }

    /// <summary>What starts at zero, for the caption; empty when nothing is left.</summary>
    [Parameter] public string? NextName { get; set; }

    /// <summary>Called once the countdown reaches zero on screen.</summary>
    [Parameter] public EventCallback OnZero { get; set; }

    protected override void OnInitialized()
    {
        seenRunning = Flow.RestCountdown && Flow.RestTarget(ExerciseId) > DateTimeOffset.Now - Since;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (await timer.WaitForNextTickAsync(stop.Token)) await InvokeAsync(TickAsync);
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private async Task TickAsync()
    {
        // Only a countdown seen reaching zero starts the next set. One that ran out while the app was elsewhere, or while the
        // phone was locked, shows how far over it is instead.
        var left = Flow.RestTarget(ExerciseId) - (DateTimeOffset.Now - Since);
        seenRunning |= Flow.RestCountdown && left > TimeSpan.Zero;
        if (!Flow.RestCountdown || left > TimeSpan.Zero || !seenRunning || done)
        {
            StateHasChanged();
            return;
        }

        done = true;
        if (left < -TimeSpan.FromSeconds(3))
        {
            StateHasChanged();
            return;
        }

        if (!Watch.Connected) Notice.Buzz();
        try
        {
            alerts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AdaptiveWorkout.UI/Components/RestTimer.razor.js");
            await alerts.InvokeVoidAsync("alert", !Watch.Connected);
        }
        catch (JSException)
        {
            // No buzz; the next set still starts.
        }

        await OnZero.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        stop.Dispose();
        try
        {
            if (alerts is not null) await alerts.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
