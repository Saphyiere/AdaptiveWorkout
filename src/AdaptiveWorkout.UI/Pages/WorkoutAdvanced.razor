@page "/workout/advanced"
@implements IDisposable
@inject WorkoutFlow Flow
@inject AppNavigation Navigation

<PageTitle>@(state?.Name ?? "Workout")</PageTitle>

@if (state is not null)
{
    var next = state.Next;
    var running = state.Running;
    var stopped = state.Sets.Where(s => s.StoppedAt is not null).ToList();
    var planIds = state.Plan.Select(e => e.ExerciseId).ToHashSet();
    var extraIds = stopped.Select(s => s.ExerciseId).Where(id => !planIds.Contains(id)).Distinct().ToList();
    var current = state.WarmingUp || state.CoolingDown ? null : running?.ExerciseId ?? next?.ExerciseId;
    <div class="screen">
        <WorkoutHeader State="state" Advanced="true" OnFinish="FinishAsync" />

        @* Each exercise's box: ticked in pen once it has sets, the pen's dot while it's the one now, empty until then. A warm-up and a
           cool-down are boxes of their own at either end. *@
        @if (state.Plan.Count > 0 || state.Session.WarmUp || state.Session.CoolDown)
        {
            <section class="ledger" aria-label="Plan">
                @if (state.Session.WarmUp)
                {
                    <div class="row @(state.WarmingUp ? "picked" : "")">
                        <span class="status">
                            @if (state.WarmingUp)
                            {
                                <span class="live-dot"></span>
                            }
                            else
                            {
                                <Mark Kind="MarkKind.Tick" Size="28" />
                            }
                        </span>
                        <span class="row-text">
                            <span class="name">Warm-up</span>
                            @if (state.Session.WarmUpEndedAt is { } warmedUpAt)
                            {
                                <span class="caption">@TimeText.Format(warmedUpAt - state.Session.StartedAt)</span>
                            }
                            else
                            {
                                <span class="caption"><Clock Since="state.Session.StartedAt" /> · now</span>
                            }
                        </span>
                    </div>
                }
                @foreach (var block in WorkoutPlan.Blocks(state.Plan))
                {
                    <div class="@(block.Count > 1 ? "superset" : "")">
                        @if (block.Count > 1)
                        {
                            <p class="label">Superset@(block[0].PlannedSets is int rounds ? $" · {rounds} rounds" : "")</p>
                        }
                        @foreach (var entry in block)
                        {
                            var exercise = state.Exercises[entry.ExerciseId];
                            var done = stopped.Where(s => s.ExerciseId == entry.ExerciseId).ToList();
                            var isCurrent = current == entry.ExerciseId;
                            var last = done.Count == 0 ? state.History(entry.ExerciseId).FirstOrDefault() : null;
                            <div class="row @(isCurrent ? "picked" : "")">
                                <span class="status">
                                    @if (isCurrent)
                                    {
                                        <span class="live-dot"></span>
                                    }
                                    else if (done.Count > 0)
                                    {
                                        <Mark Kind="MarkKind.Tick" Size="28" />
                                    }
                                </span>
                                <span class="row-text">
                                    <span class="name">@exercise.Name</span>
                                    <span class="caption">
                                        @if (state.Skipped.Contains(entry.ExerciseId))
                                        {
                                            @("Skipped")
                                        }
                                        else if (done.Count > 0)
                                        {
                                            @($"{SetSummary.Format(done, exercise.Measure)}{(isCurrent ? " · now" : "")}")
                                        }
                                        else
                                        {
                                            @(last is null ? "Not done before" : $"Last: {SetSummary.Format(last.Sets, exercise.Measure)}")
                                        }
                                    </span>
                                </span>
                            </div>
                        }
                    </div>
                }
                @if (state.Session.CoolDown)
                {
                    <div class="row @(state.CoolingDown ? "picked" : "")">
                        <span class="status">
                            @if (state.CoolingDown)
                            {
                                <span class="live-dot"></span>
                            }
                        </span>
                        <span class="row-text">
                            <span class="name">Cool-down</span>
                            @if (state.Session.CoolDownStartedAt is { } coolingSince)
                            {
                                <span class="caption"><Clock Since="coolingSince" /> · now</span>
                            }
                            else
                            {
                                <span class="caption">After the last exercise</span>
                            }
                        </span>
                    </div>
                }
            </section>
        }

        @if (extraIds.Count > 0)
        {
            <section class="stack" aria-labelledby="extra-heading">
                <h2 id="extra-heading" class="label">@(state.Plan.Count > 0 ? "Also done" : "Done so far")</h2>
                <div class="ledger">
                    @foreach (var id in extraIds)
                    {
                        var exercise = state.Exercises[id];
                        <div class="row">
                            <span class="status"><Mark Kind="MarkKind.Tick" Size="28" /></span>
                            <span class="row-text">
                                <span class="name">@exercise.Name</span>
                                <span class="caption">@SetSummary.Format([.. stopped.Where(s => s.ExerciseId == id)], exercise.Measure)</span>
                            </span>
                        </div>
                    }
                </div>
            </section>
        }

        <div class="grid-2">
            <button type="button" class="btn tall" disabled="@(running is not null || stopped.Count == 0)" @onclick="AddSet">Add a set</button>
            <button type="button" class="btn tall" disabled="@(running is not null)" @onclick="@(() => Navigation.Open("workout/exercise"))">Different exercise</button>
            <button type="button" class="btn tall" disabled="@(running is not null || next is null || state.Plan.Count == 0)" @onclick="() => Flow.Skip(next!.ExerciseId)">Skip @(next is null ? "exercise" : state.Exercises[next.ExerciseId].Name)</button>
            <a class="btn tall" href="workout" @onclick="@(() => Navigation.Replace("workout"))" @onclick:preventDefault>Back to simple</a>
        </div>

        <div class="push-down">
            @if (running is not null)
            {
                <button type="button" class="btn-primary stop" @onclick="Stop">Stop @state.Exercises[running.ExerciseId].Name</button>
            }
            else
            {
                <NextStepButton State="state" OnStarted="@(() => Navigation.Replace("workout"))" OnFinish="FinishAsync" />
            }
        </div>
    </div>
}

@code {
    private WorkoutState? state;

    protected override async Task OnInitializedAsync()
    {
        Flow.Changed += OnFlowChanged;
        state = Flow.Current ?? await Flow.LoadAsync();
        if (state is null) await Navigation.HomeAsync();
    }

    // A change made elsewhere, e.g. a set started from the watch.
    private void OnFlowChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Flow.Changed -= OnFlowChanged;

    private void AddSet()
    {
        Flow.StartSet(state!.Exercises[state.Sets[^1].ExerciseId]);
        Navigation.Replace("workout");
    }

    private void Stop()
    {
        Flow.StopSet();
        Navigation.Replace("workout");
    }

    private Task FinishAsync()
    {
        Flow.Finish();
        return Navigation.HomeAsync();
    }
}
