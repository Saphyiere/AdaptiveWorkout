@page "/routines/new"
@page "/routines/{Id:long}"
@inject WorkoutStore Store
@inject AppNavigation Navigation

<PageTitle>@(Id is null ? "New routine" : "Edit routine")</PageTitle>

@if (loaded)
{
    <div class="screen">
        <PageHeader Back="routines" BackText="Routines" Title="@(Id is null ? "New routine" : "Edit routine")" />

        <div class="field-group">
            <label class="field-label" for="routine-name">Routine name</label>
            <input id="routine-name" class="field" placeholder="Six-day split" @bind="name" @bind:event="oninput" />
        </div>

        <section class="stack" aria-labelledby="week-heading">
            <h2 id="week-heading" class="label">The week</h2>
            @if (templates.Count == 0)
            {
                <p class="note">No sessions yet. Make one below, then pick it for its days here.</p>
            }
            <div class="ledger">
                @for (var i = 0; i < 7; i++)
                {
                    var day = i;
                    <div class="row">
                        <label class="row-text" for="day-@day"><span class="name">@Schedule.Name(day)</span></label>
                        <select id="day-@day" class="field day-pick" @bind="week[day]">
                            <option value="">Rest day</option>
                            @foreach (var template in templates)
                            {
                                <option value="@template.Id">@template.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="ledger">
                <button type="button" class="row" @onclick="NewSession">
                    <span class="row-text">
                        <span class="name">New session</span>
                        <span class="note">Then back here to pick its days</span>
                    </span>
                    <Icon Name="plus" />
                </button>
            </div>
            <p class="note">@(added is null ? "The same session can be on several days, and in other routines too." : $"{added} is ready: pick it for its days above.")</p>
        </section>

        <label class="goal">
            <input type="checkbox" @bind="use" />
            <span class="row-text">
                <span class="name">Use this routine</span>
                <span class="note">Today, its Start button and the streak follow it.</span>
            </span>
        </label>

        <div class="push-down">
            @if (routine.Id != 0)
            {
                @if (deleting)
                {
                    <div class="block appear">
                        <p class="name big">Delete @routine.Name?</p>
                        <p class="note">Its sessions and your workouts stay.</p>
                        <div class="grid-2">
                            <button type="button" class="btn tall" @onclick="() => deleting = false">Keep it</button>
                            <button type="button" class="btn tall fill" @onclick="DeleteAsync">Delete</button>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="btn-ghost" @onclick="() => deleting = true">Delete routine</button>
                }
            }
            <button type="button" class="btn-primary save" disabled="@string.IsNullOrWhiteSpace(name)" @onclick="SaveAsync">Save routine</button>
        </div>
    </div>
}

@code {
    private bool loaded;
    private Routine routine = new();
    private string name = "";
    private long?[] week = new long?[7];
    private bool use;
    private bool deleting;
    private IReadOnlyList<SessionTemplate> templates = [];

    // The session just made from here, now ready to pick.
    private string? added;

    [Parameter] public long? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        templates = await Store.GetTemplatesAsync();
        var active = await Store.GetActiveRoutineAsync();
        if (Id is long id)
        {
            routine = (await Store.GetRoutinesAsync()).FirstOrDefault(r => r.Id == id) ?? new();
            week = routine.Id == 0 ? week : await Store.GetRoutineWeekAsync(routine.Id);
        }

        name = routine.Name;
        // A new routine is usually meant to be followed; an existing one is in use if it already was.
        use = routine.Id == 0 || active?.Id == routine.Id || active is null;

        // Back from making a session: the routine as it was left, changes not saved yet too.
        if (Navigation.Kept<Draft>() is { } draft)
        {
            (name, week, use) = (draft.Name, draft.Week, draft.Use);
            added = templates.FirstOrDefault(t => !draft.Sessions.Contains(t.Id))?.Name;
        }
        loaded = true;
    }

    private void NewSession()
    {
        Navigation.Keep(new Draft(name, week, use, [.. templates.Select(t => t.Id)]));
        Navigation.Open("sessions/new");
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        routine.Name = name.Trim();
        await Store.SaveRoutineAsync(routine, week);
        if (use) await Store.SetActiveRoutineAsync(routine.Id);
        else if ((await Store.GetActiveRoutineAsync())?.Id == routine.Id) await Store.SetActiveRoutineAsync(null);
        await Navigation.BackAsync("routines");
    }

    private async Task DeleteAsync()
    {
        await Store.DeleteRoutineAsync(routine);
        await Navigation.BackAsync("routines");
    }

    // The routine being edited, kept while a new session is made, and the sessions there were before it.
    private sealed record Draft(string Name, long?[] Week, bool Use, HashSet<long> Sessions);
}
