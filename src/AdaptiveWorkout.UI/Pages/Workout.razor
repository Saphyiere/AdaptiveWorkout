@page "/workout"
@inject WorkoutFlow Flow
@inject NavigationManager Nav

<PageTitle>@(state?.Name ?? "Workout")</PageTitle>

@if (state is not null)
{
    <div class="screen">
        <WorkoutHeader State="state" OnFinish="Finish" />

        @if (state.Running is { } running)
        {
            var exercise = state.Exercises[running.ExerciseId];
            var step = state.Describe(running);
            var history = state.History(running.ExerciseId);
            var firstToday = state.Sets.First(s => s.ExerciseId == running.ExerciseId);
            @* Keyed by the set, so each new step is a fresh element and its entrance animation plays. *@
            <div class="step" @key="@($"running-{running.Order}")">
                <div class="stack">
                    <p class="label @(step.SupersetRound is null ? "" : "live")">@WorkoutState.StepLabel(step)</p>
                    <h1 class="title">@exercise.Name</h1>
                    @if (state.SuggestionFor(firstToday)?.RaisedForGoal == true)
                    {
                        <span class="note-accent">@SetSummary.WeightText(firstToday.Weight) @Unit(firstToday.WeightUnit) today · you hit your goal last time</span>
                    }
                </div>

                <div class="stack">
                    <p class="label">@(exercise.Measure == ExerciseMeasure.Time ? "Time" : "Set time")</p>
                    <Clock Since="running.StartedAt!.Value" Class="number xl" />
                    <HeartRate />
                </div>

                <section class="card" aria-labelledby="history-heading">
                    <h2 id="history-heading" class="label">Last 3 times</h2>
                    @if (history.Count == 0)
                    {
                        <p class="caption">First time doing this one.</p>
                    }
                    @foreach (var past in history)
                    {
                        <div class="spread">
                            <span class="caption">@past.Session.StartedAt.ToString("ddd, MMM d", CultureInfo.CurrentCulture)</span>
                            <span class="body tabular">@SetSummary.Format(past.Sets, exercise.Measure)</span>
                        </div>
                    }
                </section>

                <div class="push-down">
                    <button type="button" class="btn-primary big" @onclick="Flow.StopSet">Stop</button>
                </div>
            </div>
        }
        else if (state.ToLog is { } logged)
        {
            var handoff = state.Next is { AfterBreak: false };
            var toConfirm = state.ToConfirm;
            <div class="step" @key="@($"break-{logged.Order}")">
                @if (handoff && state.Next is { } next)
                {
                    @* Mid-superset: straight on to the other half. Both are entered at the rest after the round. *@
                    var exercise = state.Exercises[logged.ExerciseId];
                    var nextExercise = state.Exercises[next.ExerciseId];
                    var last = state.History(next.ExerciseId).FirstOrDefault();
                    <div class="stack">
                        <p class="label live">@WorkoutState.StepLabel(state.Describe(logged))</p>
                        <h1 class="title">@exercise.Name done</h1>
                        <p class="caption">@TimeText.Format(logged.StoppedAt!.Value - logged.StartedAt!.Value) · No break inside a superset. You'll enter the round at the rest.</p>
                        <HeartRate />
                    </div>

                    <section class="card" aria-labelledby="next-heading">
                        <h2 id="next-heading" class="label">Up next</h2>
                        <div class="spread baseline">
                            <span class="body strong">@nextExercise.Name</span>
                            <span class="caption tabular">@(last is null ? "First time" : $"Last: {SetSummary.Format(last.Sets, nextExercise.Measure)}")</span>
                        </div>
                    </section>
                }
                else
                {
                    <div class="stack">
                        <p class="label">Rest</p>
                        <Clock Since="logged.StoppedAt!.Value" Class="number lg" />
                        <HeartRate />
                    </div>

                    @foreach (var set in toConfirm)
                    {
                        <SetEntry State="state" Set="set" OnSaved="() => { }" @key="set.Order" />
                    }

                    @if (toConfirm.Count == 0)
                    {
                        @* Everything entered: the rest screen becomes a look at the whole workout so far. *@
                        <section class="card appear" aria-labelledby="today-heading">
                            <div class="spread">
                                <h2 id="today-heading" class="label">Today so far</h2>
                                <button type="button" class="btn" @onclick="Flow.EditRound">Edit</button>
                            </div>
                            @foreach (var exerciseSets in state.Sets.Where(s => s.StoppedAt is not null).GroupBy(s => s.ExerciseId))
                            {
                                var exercise = state.Exercises[exerciseSets.Key];
                                <div class="row-text">
                                    <span class="body strong inline">
                                        @exercise.Name
                                        @if (exerciseSets.Any(s => s.HitGoal))
                                        {
                                            <Icon Name="check" Size="16" Stroke="2" Color="var(--accent)" />
                                        }
                                    </span>
                                    <span class="caption tabular">@SetSummary.Format([.. exerciseSets], exercise.Measure)</span>
                                </div>
                            }
                        </section>
                    }
                }

                <div class="push-down">
                    <NextStepButton State="state" OnStarted="() => { }" OnFinish="Finish" />
                </div>
            </div>
        }
    </div>
}

@code {
    private WorkoutState? state;

    protected override async Task OnInitializedAsync()
    {
        state = Flow.Current ?? await Flow.LoadAsync();
        if (state is null) Nav.NavigateTo("", replace: true);
        else if (state.Sets.Count == 0) Nav.NavigateTo("workout/exercise", replace: true);
    }

    private static string Unit(WeightUnit unit) => unit == WeightUnit.Kilograms ? "kg" : "lb";

    private void Finish()
    {
        Flow.Finish();
        Nav.NavigateTo("");
    }
}
