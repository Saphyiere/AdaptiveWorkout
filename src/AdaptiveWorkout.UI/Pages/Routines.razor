@page "/routines"
@inject WorkoutStore Store

<PageTitle>Routines</PageTitle>

@if (loaded)
{
    <div class="screen tight">
        <header class="inline">
            <a class="icon-btn" href="sessions" aria-label="Back to sessions"><Icon Name="back" /></a>
            <h1 class="title small">Routines</h1>
        </header>
        <p class="caption">A routine plans the week: a session or a rest day for each day. Today and the streak follow the one in use; tap another to switch.</p>

        <section class="list" aria-label="Routines">
            @foreach (var (routine, week) in routines)
            {
                var inUse = routine.Id == activeId;
                var restDays = Enumerable.Range(0, 7).Where(i => week[i] is null).Select(Schedule.ShortName).ToList();
                <div class="row" @key="routine.Id">
                    <button type="button" class="row-main" aria-pressed="@(inUse ? "true" : "false")" @onclick="() => UseAsync(routine.Id)">
                        <span class="status @(inUse ? "current" : "")">
                            @if (inUse)
                            {
                                <Icon Name="check" Size="16" Stroke="2" Color="var(--accent)" />
                            }
                        </span>
                        <span class="row-text">
                            <span class="body strong">@routine.Name</span>
                            <span class="caption">@(restDays.Count == 7 ? "No days planned yet" : $"{7 - restDays.Count} gym days{(restDays.Count > 0 ? $" · rest {string.Join(", ", restDays)}" : "")}")</span>
                        </span>
                    </button>
                    <a class="icon-btn plain" href="routines/@routine.Id" aria-label="Edit @routine.Name"><Icon Name="edit" /></a>
                </div>
            }
            <button type="button" class="row" aria-pressed="@(activeId is null ? "true" : "false")" @onclick="() => UseAsync(null)">
                <span class="status @(activeId is null ? "current" : "")">
                    @if (activeId is null)
                    {
                        <Icon Name="check" Size="16" Stroke="2" Color="var(--accent)" />
                    }
                </span>
                <span class="row-text">
                    <span class="body strong">No routine</span>
                    <span class="caption">Any day is a gym day, and the streak counts weeks.</span>
                </span>
            </button>
        </section>

        <section class="list">
            <a class="row" href="routines/new">
                <span class="icon-btn"><Icon Name="plus" /></span>
                <span class="row-text">
                    <span class="body strong">New routine</span>
                    <span class="caption">Pick a session or a rest day for each day</span>
                </span>
            </a>
        </section>
    </div>
}

@code {
    private bool loaded;
    private long? activeId;
    private List<(Routine Routine, long?[] Week)> routines = [];

    protected override async Task OnInitializedAsync()
    {
        activeId = (await Store.GetActiveRoutineAsync())?.Id;
        foreach (var routine in await Store.GetRoutinesAsync()) routines.Add((routine, await Store.GetRoutineWeekAsync(routine.Id)));
        loaded = true;
    }

    private async Task UseAsync(long? routineId)
    {
        activeId = routineId;
        await Store.SetActiveRoutineAsync(routineId);
    }
}
