@page "/routines"
@inject WorkoutStore Store

<PageTitle>Routines</PageTitle>

@if (loaded)
{
    var (back, backText) = From switch { "gym" => ("gym", "Gym"), "today" => ("", "Today"), _ => ("sessions", "Sessions") };
    <div class="screen">
        <PageHeader Back="@back" BackText="@backText" Title="Routines" />
        <p class="note">A routine plans the week: a session or a rest day for each day. Today and the streak follow the one in use; tap another to switch.</p>

        <section class="ledger" aria-label="Routines">
            @foreach (var (routine, week) in routines)
            {
                var inUse = routine.Id == activeId;
                var restDays = Enumerable.Range(0, 7).Where(i => week[i] is null).Select(Schedule.ShortName).ToList();
                <div class="row" @key="routine.Id">
                    <button type="button" class="row-main" aria-pressed="@(inUse ? "true" : "false")" @onclick="() => UseAsync(routine.Id)">
                        <span class="status">
                            @if (inUse)
                            {
                                <Mark Kind="MarkKind.Tick" Size="28" />
                            }
                        </span>
                        <span class="row-text">
                            <span class="name">@routine.Name</span>
                            <span class="caption">@(restDays.Count == 7 ? "No days planned yet" : $"{7 - restDays.Count} gym days{(restDays.Count > 0 ? $" · rest {string.Join(", ", restDays)}" : "")}")</span>
                        </span>
                    </button>
                    <a class="icon-btn plain" href="@($"routines/{routine.Id}{FromQuery}")" aria-label="Edit @routine.Name"><Icon Name="edit" /></a>
                </div>
            }
            <button type="button" class="row" aria-pressed="@(activeId is null ? "true" : "false")" @onclick="() => UseAsync(null)">
                <span class="status">
                    @if (activeId is null)
                    {
                        <Mark Kind="MarkKind.Tick" Size="28" />
                    }
                </span>
                <span class="row-text">
                    <span class="name">No routine</span>
                    <span class="caption">Any day is a gym day, and the streak counts weeks.</span>
                </span>
            </button>
            <a class="row" href="@($"routines/new{FromQuery}")">
                <span class="row-text">
                    <span class="name">New routine</span>
                    <span class="note">Pick a session or a rest day for each day</span>
                </span>
                <Icon Name="plus" />
            </a>
        </section>
    </div>
}

@code {
    private bool loaded;
    private long? activeId;
    private List<(Routine Routine, long?[] Week)> routines = [];

    /// <summary>Where the back arrow goes: Gym or Today, which link here too, or else the session picker.</summary>
    [SupplyParameterFromQuery] public string? From { get; set; }

    // Carried to the routine editor and back, so the back arrow here still knows.
    private string FromQuery => From is "gym" or "today" ? $"?from={From}" : "";

    protected override async Task OnInitializedAsync()
    {
        activeId = (await Store.GetActiveRoutineAsync())?.Id;
        foreach (var routine in await Store.GetRoutinesAsync()) routines.Add((routine, await Store.GetRoutineWeekAsync(routine.Id)));
        loaded = true;
    }

    private async Task UseAsync(long? routineId)
    {
        activeId = routineId;
        await Store.SetActiveRoutineAsync(routineId);
    }
}
