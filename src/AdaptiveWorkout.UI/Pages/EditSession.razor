@page "/sessions/new"
@page "/sessions/{Id:long}"
@inject WorkoutStore Store
@inject AppNavigation Navigation

<PageTitle>@(Id is null ? "New session" : "Edit session")</PageTitle>

@if (loaded)
{
    <div class="screen">
        <PageHeader Back="sessions" BackText="Sessions" Title="@(Id is null ? "New session" : "Edit session")" />

        <div class="field-group">
            <label class="field-label" for="session-name">Session name</label>
            <input id="session-name" class="field" placeholder="Back day" @bind="name" @bind:event="oninput" />
        </div>

        <section class="stack" aria-labelledby="exercises-heading">
            <h2 id="exercises-heading" class="label">Exercises, in order</h2>
            @* A warm-up and a cool-down sit where they happen: before the first exercise and after the last. *@
            <label class="goal">
                <input type="checkbox" @bind="template.WarmUp" />
                <span class="row-text">
                    <span class="name">Warm-up first</span>
                    <span class="note">Timed, with heart rate. The big button then starts the first exercise.</span>
                </span>
            </label>
            @if (entries.Count == 0)
            {
                <p class="note">Add the exercises you do in this session. Start workout goes through them in this order.</p>
            }
            else
            {
                <div class="ledger">
                    @for (var i = 0; i < entries.Count; i++)
                    {
                        var index = i;
                        var entry = entries[i];
                        var joinedToPrevious = i > 0 && entries[i - 1].LinkedToNext;
                        var linked = entry.LinkedToNext && i < entries.Count - 1;
                        @* A superset is bracketed in the pen's color down its exercises' left edge. *@
                        <div class="entry @(linked || joinedToPrevious ? "superset" : "")">
                            @if (linked && !joinedToPrevious)
                            {
                                <p class="label">Superset</p>
                            }
                            <div class="spread">
                                <span class="name">@entry.Exercise.Name</span>
                                <div class="inline">
                                    <button type="button" class="icon-btn plain" aria-label="Move @entry.Exercise.Name up" disabled="@(index == 0)" @onclick="() => Move(index, -1)"><Icon Name="up" /></button>
                                    <button type="button" class="icon-btn plain" aria-label="Move @entry.Exercise.Name down" disabled="@(index == entries.Count - 1)" @onclick="() => Move(index, 1)"><Icon Name="down" /></button>
                                    <button type="button" class="icon-btn plain" aria-label="Remove @entry.Exercise.Name" @onclick="() => entries.RemoveAt(index)"><Icon Name="close" /></button>
                                </div>
                            </div>
                            @if (joinedToPrevious)
                            {
                                <p class="note">Alternates with the exercise above, same number of rounds.</p>
                            }
                            else
                            {
                                <div class="spread">
                                    <div class="row-text">
                                        <span class="body">@(linked ? "Rounds" : "Sets")</span>
                                        <span class="caption">@(entry.PlannedSets is null ? "No count: as many as last time" : linked ? "Each round is one set of each exercise" : "Then Start workout moves on")</span>
                                    </div>
                                    <div class="stepper">
                                        <button type="button" class="icon-btn" aria-label="Fewer" disabled="@(entry.PlannedSets is null)" @onclick="() => entry.PlannedSets = entry.PlannedSets > 1 ? entry.PlannedSets - 1 : null"><Icon Name="minus" Size="18" /></button>
                                        <span class="@(entry.PlannedSets is null ? "note center" : "number")" aria-live="polite">@(entry.PlannedSets?.ToString(CultureInfo.CurrentCulture) ?? "Auto")</span>
                                        <button type="button" class="icon-btn" aria-label="More" @onclick="() => entry.PlannedSets = (entry.PlannedSets ?? 0) + 1"><Icon Name="plus" Size="18" /></button>
                                    </div>
                                </div>
                            }
                            @if (index < entries.Count - 1)
                            {
                                <label class="goal">
                                    <input type="checkbox" @bind="entry.LinkedToNext" />
                                    Superset with the next exercise
                                </label>
                            }
                        </div>
                    }
                </div>
            }
            <label class="goal">
                <input type="checkbox" @bind="template.CoolDown" />
                <span class="row-text">
                    <span class="name">Cool-down last</span>
                    <span class="note">Timed, with heart rate, from after the last exercise until Finish.</span>
                </span>
            </label>
        </section>

        <div class="field-group">
            <label class="field-label" for="add-exercise">Add an exercise</label>
            <div class="inline end">
                <input id="add-exercise" class="field" placeholder="Type a name" autocomplete="off" @bind="newName" @bind:event="oninput" />
                <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(newName)" @onclick="AddAsync"><Icon Name="plus" Size="16" />Add</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(newName))
        {
            var key = ExerciseNames.Key(newName);
            var matches = exercises.Where(e => ExerciseNames.Key(e.Name).Contains(key) && entries.All(x => x.Exercise.Id != e.Id)).Take(5).ToList();
            @if (matches.Count > 0)
            {
                <section class="ledger" aria-label="Exercises you've done before">
                    @foreach (var match in matches)
                    {
                        <button type="button" class="row" @onclick="() => AddExisting(match)">
                            <span class="row-text">
                                <span class="name">@match.Name</span>
                                <span class="note">done before · @(match.Measure == ExerciseMeasure.Time ? "time" : "weight")</span>
                            </span>
                            <Icon Name="plus" />
                        </button>
                    }
                </section>
            }
            @if (exercises.All(e => ExerciseNames.Key(e.Name) != key))
            {
                <div class="stack">
                    <p class="note">New exercise. Track it by</p>
                    <div class="segmented" role="group" aria-label="Track by">
                        <button type="button" aria-pressed="@(newMeasure == ExerciseMeasure.Weight ? "true" : "false")" @onclick="() => newMeasure = ExerciseMeasure.Weight">Weight and reps</button>
                        <button type="button" aria-pressed="@(newMeasure == ExerciseMeasure.Time ? "true" : "false")" @onclick="() => newMeasure = ExerciseMeasure.Time">Time</button>
                    </div>
                </div>
            }
        }

        <div class="push-down">
            <button type="button" class="btn-primary save" disabled="@string.IsNullOrWhiteSpace(name)" @onclick="SaveAsync">Save session</button>
        </div>
    </div>
}

@code {
    private bool loaded;
    private SessionTemplate template = new();
    private string name = "";
    private List<Entry> entries = [];
    private IReadOnlyList<Exercise> exercises = [];
    private string newName = "";
    private ExerciseMeasure newMeasure = ExerciseMeasure.Weight;

    [Parameter] public long? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        exercises = await Store.GetExercisesAsync();
        template = Id is long id ? await Store.GetTemplateAsync(id) ?? new() : new();
        name = template.Name;

        IReadOnlyList<TemplateExercise> saved = template.Id == 0 ? [] : await Store.GetTemplateExercisesAsync(template.Id);
        entries = [.. saved.Select((e, i) => new Entry
        {
            Exercise = exercises.First(x => x.Id == e.ExerciseId),
            PlannedSets = e.PlannedSets,
            LinkedToNext = e.SupersetGroup is not null && i < saved.Count - 1 && saved[i + 1].SupersetGroup == e.SupersetGroup,
        })];
        loaded = true;
    }

    private void Move(int index, int offset)
    {
        (entries[index], entries[index + offset]) = (entries[index + offset], entries[index]);
    }

    private void AddExisting(Exercise exercise)
    {
        entries.Add(new Entry { Exercise = exercise });
        newName = "";
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;

        AddExisting(await Store.GetOrCreateExerciseAsync(newName, newMeasure));
        exercises = await Store.GetExercisesAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        // Neighbors linked by "superset with the next exercise" share a group number; the first one's count covers the superset.
        var saved = new List<TemplateExercise>();
        int? group = null;
        for (var i = 0; i < entries.Count; i++)
        {
            var joinedToPrevious = i > 0 && entries[i - 1].LinkedToNext;
            var linked = entries[i].LinkedToNext && i < entries.Count - 1;
            if (!joinedToPrevious) group = linked ? i + 1 : null;
            saved.Add(new TemplateExercise { ExerciseId = entries[i].Exercise.Id, Order = i, PlannedSets = joinedToPrevious ? null : entries[i].PlannedSets, SupersetGroup = group });
        }

        template.Name = name.Trim();
        await Store.SaveTemplateAsync(template, saved);
        await Navigation.BackAsync("sessions");
    }

    private sealed class Entry
    {
        public required Exercise Exercise { get; init; }
        public int? PlannedSets { get; set; }
        public bool LinkedToNext { get; set; }
    }
}
