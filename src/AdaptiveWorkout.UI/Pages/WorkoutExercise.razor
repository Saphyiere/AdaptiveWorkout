@page "/workout/exercise"
@inject WorkoutFlow Flow
@inject WorkoutStore Store
@inject NavigationManager Nav

<PageTitle>Pick an exercise</PageTitle>

@if (state is not null)
{
    var key = ExerciseNames.Key(query);
    var sessionStarts = state.AllSessions.ToDictionary(s => s.Id, s => s.StartedAt);
    var remainingPlan = state.Plan.Select(e => state.Exercises[e.ExerciseId]).Where(e => state.Sets.All(s => s.ExerciseId != e.Id)).ToList();
    var doneBefore = state.AllSets.Where(s => s.SessionId != state.Session.Id && remainingPlan.All(e => e.Id != s.ExerciseId)).GroupBy(s => s.ExerciseId)
        .OrderByDescending(g => g.Max(s => sessionStarts[s.SessionId])).Select(g => state.Exercises[g.Key]).ToList();
    var isNew = key.Length > 0 && state.Exercises.Values.All(e => ExerciseNames.Key(e.Name) != key);
    <div class="screen tight">
        <header class="inline">
            @if (state.Sets.Count == 0)
            {
                <a class="icon-btn" href="" aria-label="Back to Today"><Icon Name="back" /></a>
            }
            else
            {
                <a class="icon-btn" href="workout" aria-label="Close"><Icon Name="close" /></a>
            }
            <h1 class="title small">@(state.Sets.Count == 0 ? "First exercise" : "Different exercise")</h1>
        </header>

        <div class="field-group">
            <label class="field-label" for="exercise-name">Exercise</label>
            <input id="exercise-name" class="field" placeholder="Type a name" autocomplete="off" @bind="query" @bind:event="oninput" />
        </div>

        @if (key.Length == 0)
        {
            @if (remainingPlan.Count > 0)
            {
                <h2 class="label">Still to do in @state.Name</h2>
                <ExerciseList Exercises="remainingPlan" State="state" OnPick="StartAsync" />
            }
            @if (doneBefore.Count > 0)
            {
                <h2 class="label">Done before</h2>
                <ExerciseList Exercises="doneBefore.Take(8).ToList()" State="state" OnPick="StartAsync" />
            }
        }
        else
        {
            var matches = state.Exercises.Values.Where(e => ExerciseNames.Key(e.Name).Contains(key)).OrderBy(e => e.Name).Take(8).ToList();
            @if (matches.Count > 0)
            {
                <h2 class="label">Matches</h2>
                <ExerciseList Exercises="matches" State="state" OnPick="StartAsync" />
            }
            @if (isNew)
            {
                <h2 class="label">New exercise</h2>
                <section class="card">
                    <p class="body strong">“@ExerciseNames.Clean(query)”</p>
                    <div class="segmented" role="group" aria-label="Track by">
                        <button type="button" aria-pressed="@(measure == ExerciseMeasure.Weight ? "true" : "false")" @onclick="() => measure = ExerciseMeasure.Weight">Weight and reps</button>
                        <button type="button" aria-pressed="@(measure == ExerciseMeasure.Time ? "true" : "false")" @onclick="() => measure = ExerciseMeasure.Time">Time</button>
                    </div>
                </section>
            }
        }

        <div class="push-down">
            @if (isNew)
            {
                <button type="button" class="btn-primary big" @onclick="StartNewAsync">Start set</button>
            }
            @if (state.Sets.Count == 0)
            {
                <button type="button" class="btn-ghost" @onclick="CancelAsync">Cancel workout</button>
            }
        </div>
    </div>
}

@code {
    private WorkoutState? state;
    private string query = "";
    private ExerciseMeasure measure = ExerciseMeasure.Weight;

    protected override async Task OnInitializedAsync()
    {
        state = await Flow.LoadAsync();
        if (state is null) Nav.NavigateTo("", replace: true);
        else if (state.Running is not null) Nav.NavigateTo("workout", replace: true);
    }

    private async Task StartAsync(Exercise exercise)
    {
        await Flow.StartSetAsync(state!, exercise);
        Nav.NavigateTo("workout");
    }

    private async Task StartNewAsync() => await StartAsync(await Store.GetOrCreateExerciseAsync(query, measure));

    private async Task CancelAsync()
    {
        await Flow.CancelAsync(state!);
        Nav.NavigateTo("");
    }
}
