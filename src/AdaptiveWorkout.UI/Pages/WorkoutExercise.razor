@page "/workout/exercise"
@inject WorkoutFlow Flow
@inject NavigationManager Nav

<PageTitle>Pick an exercise</PageTitle>

@if (state is not null)
{
    var stillToDo = state.StillToDo().Select(id => state.Exercises[id]).ToList();
    <div class="screen tight">
        <header class="inline">
            @if (state.Sets.Count == 0)
            {
                <a class="icon-btn" href="" aria-label="Back to Today"><Icon Name="back" /></a>
            }
            else
            {
                <a class="icon-btn" href="workout" aria-label="Close"><Icon Name="close" /></a>
            }
            <h1 class="title small">@(state.Sets.Count == 0 ? "First exercise" : "Different exercise")</h1>
        </header>

        <ExercisePicker State="state" OnPick="Start" Exclude="@stillToDo.Select(e => e.Id).ToHashSet()" NewAction="Start set">
            <BeforeTyping>
                @if (stillToDo.Count > 0)
                {
                    <h2 class="label">Still to do in @state.Name</h2>
                    <ExerciseList Exercises="stillToDo" State="state" OnPick="Start" />
                }
            </BeforeTyping>
        </ExercisePicker>

        @if (state.Sets.Count == 0)
        {
            <div class="push-down">
                <button type="button" class="btn-ghost" @onclick="Cancel">Cancel workout</button>
            </div>
        }
    </div>
}

@code {
    private WorkoutState? state;

    protected override async Task OnInitializedAsync()
    {
        state = Flow.Current ?? await Flow.LoadAsync();
        if (state is null) Nav.NavigateTo("", replace: true);
        else if (state.Running is not null) Nav.NavigateTo("workout", replace: true);
    }

    private void Start(Exercise exercise)
    {
        Flow.StartSet(exercise);
        Nav.NavigateTo("workout");
    }

    private void Cancel()
    {
        Flow.Cancel();
        Nav.NavigateTo("");
    }
}
