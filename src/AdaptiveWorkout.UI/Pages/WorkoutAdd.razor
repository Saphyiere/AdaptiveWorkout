@page "/workout/add"
@inject WorkoutFlow Flow
@inject WorkoutStore Store
@inject NavigationManager Nav

<PageTitle>Add to today</PageTitle>

@if (state is not null)
{
    <div class="screen tight">
        <header class="inline">
            <a class="icon-btn" href="workout" aria-label="Close"><Icon Name="close" /></a>
            <div class="row-text">
                <p class="label">@state.Name</p>
                <h1 class="title small">Add to today</h1>
            </div>
        </header>
        <p class="caption">It goes after everything else in today's workout. The session itself stays as it is.</p>

        @if (sessions.Count > 0)
        {
            <section class="stack" aria-labelledby="sessions-heading">
                <h2 id="sessions-heading" class="label">A whole session</h2>
                <div class="list">
                    @foreach (var (template, exerciseCount) in sessions)
                    {
                        <button type="button" class="row" @onclick="() => AddSessionAsync(template)">
                            <span class="row-text">
                                <span class="body strong">@template.Name</span>
                                <span class="caption">@exerciseCount @(exerciseCount == 1 ? "exercise" : "exercises")</span>
                            </span>
                            <Icon Name="plus" />
                        </button>
                    }
                </div>
            </section>
        }

        <section class="stack" aria-labelledby="exercise-heading">
            <h2 id="exercise-heading" class="label">One exercise</h2>
            <ExercisePicker State="state" OnPick="AddExercise" Exclude="@state.Plan.Select(e => e.ExerciseId).ToHashSet()" Id="add-name" Label="Exercise" NewAction="Add it" />
        </section>
    </div>
}

@code {
    private WorkoutState? state;
    private List<(SessionTemplate Template, int ExerciseCount)> sessions = [];

    protected override async Task OnInitializedAsync()
    {
        state = Flow.Current ?? await Flow.LoadAsync();
        if (state is null)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        foreach (var template in await Store.GetTemplatesAsync()) sessions.Add((template, (await Store.GetTemplateExercisesAsync(template.Id)).Count));
    }

    private async Task AddSessionAsync(SessionTemplate template)
    {
        await Flow.AddSessionAsync(template.Id);
        Nav.NavigateTo("workout");
    }

    private void AddExercise(Exercise exercise)
    {
        Flow.AddExercise(exercise);
        Nav.NavigateTo("workout");
    }
}
