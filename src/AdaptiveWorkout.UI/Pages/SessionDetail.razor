@page "/history/{Id:long}"
@inject WorkoutStore Store
@inject WorkoutFlow Flow
@inject AppSettings Settings
@inject AppNavigation Navigation

<PageTitle>@name</PageTitle>

@if (session is not null)
{
    var heartRate = WorkoutStats.HeartRate(samples, session.StartedAt, session.FinishedAt ?? session.StartedAt);
    var time = TimeText.Format((session.FinishedAt ?? session.StartedAt) - session.StartedAt);
    var volume = WorkoutStats.Volume(sets, Settings.Unit).ToString("N0", CultureInfo.CurrentCulture);
    <div class="screen">
        <PageHeader Back="gym" BackText="Gym" Label="@session.StartedAt.ToString("dddd, MMM d · h:mm tt", CultureInfo.CurrentCulture)" Title="@name" />

        @* The time and volume can run long (1:02:05, 14,250), so they say how many characters they have, for the type to fit them. *@
        <section class="block" aria-label="Summary">
            <div class="grid-2 readouts">
                <div class="row-text">
                    <span class="label">Time</span>
                    <span class="number sm" style="--chars: @time.Length">@time</span>
                </div>
                <div class="row-text">
                    <span class="label">Sets</span>
                    <span class="number sm">@sets.Count</span>
                </div>
                <div class="row-text">
                    <span class="label">Volume</span>
                    <span class="inline baseline">
                        <span class="number sm" style="--chars: @volume.Length">@volume</span>
                        <span class="unit">@Unit(Settings.Unit)</span>
                    </span>
                </div>
                <div class="row-text">
                    <span class="label">Heart rate</span>
                    @if (heartRate is { } bpm)
                    {
                        <span class="inline baseline">
                            <span class="number sm">@bpm.Average</span>
                            <span class="unit">avg · @bpm.Max max</span>
                        </span>
                    }
                    else
                    {
                        <span class="note">No readings</span>
                    }
                </div>
                @* What it burned on top of resting, give or take a third (Calories.BurnedError). *@
                <div class="row-text">
                    <span class="label">Burned</span>
                    @if (burned is int calories)
                    {
                        var (low, high) = (Math.Round(calories * (1 - Calories.BurnedError) / 10) * 10, Math.Round(calories * (1 + Calories.BurnedError) / 10) * 10);
                        <span class="inline baseline">
                            <span class="number sm">@calories.ToString("N0", CultureInfo.CurrentCulture)</span>
                            <span class="unit">kcal</span>
                        </span>
                        <span class="caption">likely @low.ToString("N0", CultureInfo.CurrentCulture)–@high.ToString("N0", CultureInfo.CurrentCulture), above resting</span>
                    }
                    else
                    {
                        <span class="note">Weigh in to see it</span>
                    }
                </div>
            </div>
        </section>

        @if (session.WarmUpEndedAt is { } warmedUpAt)
        {
            @Phase("Warm-up", session.StartedAt, warmedUpAt)
        }

        @* Every set by exercise; tapping one changes or deletes it. *@
        <SetList Sets="sets" Exercises="exercises" Samples="samples" OnSave="SaveSetAsync" OnDelete="DeleteSetAsync" />

        @if (session.CoolDownStartedAt is { } cooledFrom)
        {
            @Phase("Cool-down", cooledFrom, session.FinishedAt!.Value)
        }

        <div class="push-down">
            @if (confirming)
            {
                <div class="block appear">
                    <p class="name big">Delete this workout?</p>
                    <p class="note">@name on @session.StartedAt.ToString("MMM d", CultureInfo.CurrentCulture) @(sets.Count == 0 ? "is" : $"and its {sets.Count} {(sets.Count == 1 ? "set" : "sets")} are") deleted for good.</p>
                    <div class="grid-2">
                        <button type="button" class="btn tall" @onclick="() => confirming = false">Keep it</button>
                        <button type="button" class="btn tall fill" @onclick="DeleteAsync">Delete</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="btn-ghost" @onclick="() => confirming = true"><Icon Name="trash" Size="18" />Delete workout</button>
            }
        </div>
    </div>
}

@code {
    private WorkoutSession? session;
    private string name = "Workout";
    private List<WorkoutSet> sets = [];
    private Dictionary<long, Exercise> exercises = [];
    private List<HeartRateSample> samples = [];
    private int? burned;
    private bool confirming;

    [Parameter] public long Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        session = await Store.GetSessionAsync(Id) is { FinishedAt: not null } finished ? finished : null;
        if (session is null)
        {
            await Navigation.BackAsync("gym");
            return;
        }

        name = session.TemplateId is long templateId ? (await Store.GetTemplateAsync(templateId))?.Name ?? name : name;
        sets = await Store.GetSessionSetsAsync(Id);
        exercises = (await Store.GetExercisesAsync()).ToDictionary(e => e.Id);
        samples = await Store.GetHeartRateAsync(session.StartedAt, session.FinishedAt!.Value);

        // What it burned, at its average heart rate: kept since Finish, or from these readings for a workout not measured yet.
        var (from, to) = Calories.WorkoutTime(session, sets);
        var during = samples.Where(s => s.At >= from && s.At <= to).ToList();
        session.AverageBpm ??= during.Count == 0 ? 0 : during.Average(s => s.Bpm);
        burned = Calories.BurnedByDay([session], sets, exercises, await Store.GetBodyWeightsAsync(), Settings) is { Count: > 0 } byDay ? byDay.Values.Single() : null;
    }

    private static string Unit(WeightUnit unit) => unit == WeightUnit.Kilograms ? "kg" : "lb";

    // The warm-up or the cool-down: how long it took, and the heart rate through it.
    private RenderFragment Phase(string title, DateTimeOffset from, DateTimeOffset to) =>
        @<section class="block" aria-label="@title">
            <div class="spread baseline">
                <h2 class="name big">@title</h2>
                <span class="name big tabular">@TimeText.Format(to - from)</span>
            </div>
            @if (WorkoutStats.HeartRate(samples, from, to) is { } bpm)
            {
                <p class="caption">@bpm.Average bpm avg · @bpm.Max max</p>
            }
        </section>;

    // A changed or deleted set changes how this workout, and every later one, compared with the last time.
    private Task SaveSetAsync(WorkoutSet set) => Flow.SavePastSetAsync(set);

    private Task DeleteSetAsync(WorkoutSet set)
    {
        sets.Remove(set);
        return Flow.DeletePastSetAsync(set);
    }

    private async Task DeleteAsync()
    {
        await Flow.DeleteSessionAsync(session!);
        await Navigation.BackAsync("gym");
    }
}
