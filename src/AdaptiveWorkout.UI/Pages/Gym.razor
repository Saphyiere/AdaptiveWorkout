@page "/gym"
@inject WorkoutStore Store
@inject WorkoutFlow Flow

<PageTitle>Gym</PageTitle>

@if (loaded)
{
    var trend = Progress.Trend(sessions, exercisesDone);
    var shown = trend.Count == 0 ? null : trend.Find(p => p.Session == picked).Session ?? trend[^1].Session;
    var telemetry = Theme == Theme.Telemetry;
    <div class="screen">
        <PageHeader Back="" BackText="Today" Label="@($"{sessions.Count} {(sessions.Count == 1 ? "workout" : "workouts")}")" Title="Gym" />

        @* Am I getting better? Each workout's improvement, worked out once after Finish, adds up to one line. *@
        <section class="block" aria-labelledby="trend-heading">
            @if (telemetry && trend.Count > 0)
            {
                <div class="spread">
                    <h2 id="trend-heading" class="label tag channel-train">Improvement</h2>
                    <p class="label">Over @trend.Count @(trend.Count == 1 ? "workout" : "workouts")</p>
                </div>
            }
            else
            {
                <h2 id="trend-heading" class="label">Improvement</h2>
            }
            @if (trend.Count == 0)
            {
                <p class="note">Your trend starts once you repeat an exercise from an earlier workout.</p>
            }
            else
            {
                var index = trend.FindIndex(p => p.Session == shown);
                var pickedTotal = trend[index].Total;

                // A y-axis of round steps, with 0% always on it and at most five lines.
                var low = Math.Min(0, trend.Min(p => p.Total));
                var high = Math.Max(0, trend.Max(p => p.Total));
                var step = Steps.FirstOrDefault(s => Math.Ceiling(high / s) - Math.Floor(low / s) <= 4, Math.Ceiling(high - low));
                var bottom = Math.Floor(low / step) * step;
                var top = Math.Max(Math.Ceiling(high / step) * step, bottom + step);
                var ticks = Enumerable.Range(0, (int)Math.Round((top - bottom) / step) + 1).Select(i => bottom + i * step).ToList();
                double X(int i) => PlotLeft + (i + 0.5) * (ChartWidth - PlotLeft) / trend.Count;
                double Y(double total) => PlotBottom - (total - bottom) / (top - bottom) * (PlotBottom - PlotTop);
                var line = string.Join(' ', trend.Select((p, i) => $"{N(X(i))},{N(Y(p.Total))}"));

                // A note at the low point, when it's a dip along the way rather than an end.
                var lowest = trend.FindIndex(p => p.Total == trend.Min(q => q.Total));
                var noteDip = lowest > 0 && lowest < trend.Count - 1 && lowest != index;

                <p class="number hero">@PercentText.Format(trend[^1].Total)</p>
                <p class="note">@(telemetry ? "Better than your first time, on average" : $"How much better your exercises are than the first time, on average, over {trend.Count} {(trend.Count == 1 ? "workout" : "workouts")}.")</p>
                <div class="trend-chart">
                    <svg viewBox="0 0 @N(ChartWidth) @N(ChartHeight)" role="img" aria-label="@($"Improvement over {trend.Count} workouts: {PercentText.Format(trend[^1].Total)}")">
                        @* In a group, since Razor reads a <text> that starts a code block's markup as its own text tag. *@
                        @foreach (var tick in ticks)
                        {
                            <g>
                                <line class="grid" x1="@N(PlotLeft)" x2="@N(ChartWidth)" y1="@N(Y(tick) + 0.5)" y2="@N(Y(tick) + 0.5)" />
                                <text class="tick" x="@N(PlotLeft - 8)" y="@N(Y(tick) + 4.5)" text-anchor="end">@(tick == 0 ? "0" : TickText(tick))</text>
                            </g>
                        }
                        @if (telemetry)
                        {
                            @* A square marker on every workout, a tick under each, and a crosshair through the one picked. *@
                            <path class="axis" d="@string.Concat(trend.Select((_, i) => $"M{N(X(i) + 0.5)} {N(PlotBottom)}V{N(PlotBottom + 6)}"))" />
                            <path class="crosshair" d="@($"M{N(X(index) + 0.5)} 0V{N(PlotBottom + 6)}M{N(PlotLeft)} {N(Y(pickedTotal) + 0.5)}H{N(ChartWidth)}")" />
                            <polyline class="trend-line" points="@line" />
                            @foreach (var i in Enumerable.Range(0, trend.Count).Where(i => i != index))
                            {
                                <rect class="marker" x="@N(X(i) - 2.5)" y="@N(Y(trend[i].Total) - 2.5)" width="5" height="5" />
                            }
                            <rect class="picked-frame" x="@N(X(index) - 6.5)" y="@N(Y(pickedTotal) - 6.5)" width="13" height="13" />
                            <rect class="marker" x="@N(X(index) - 4.5)" y="@N(Y(pickedTotal) - 4.5)" width="9" height="9" />
                        }
                        else
                        {
                            @if (noteDip)
                            {
                                <g>
                                    <line class="leader" x1="@N(X(lowest) + 0.5)" x2="@N(X(lowest) + 0.5)" y1="@N(Y(trend[lowest].Total) + 6)" y2="@N(Y(trend[lowest].Total) + 18)" />
                                    <text class="aside" x="@N(X(lowest))" y="@N(Y(trend[lowest].Total) + 30)" text-anchor="middle">@DateText(trend[lowest].Session)</text>
                                </g>
                            }
                            <line class="picked-line" x1="@N(X(index) + 0.5)" x2="@N(X(index) + 0.5)" y1="@N(Y(pickedTotal) + 10)" y2="@N(PlotBottom)" />
                            <polyline class="trend-line" points="@line" />
                            <circle class="dot" cx="@N(X(index))" cy="@N(Y(pickedTotal))" r="4" />
                            <path class="pen" stroke-width="2.5" transform="@($"translate({N(X(index) - 15.6)} {N(Y(pickedTotal) - 12.7)}) scale(0.8)")" d="M33 8C27 2.5 9 2.5 4.5 11C0.5 19 9 28.5 21 27.5C32 26.5 38 18.5 34.5 10.5L31 6.5" />
                        }
                        <text class="tick" x="@N(X(0))" y="@N(ChartHeight - 4)" text-anchor="@(trend.Count == 1 ? "middle" : "start")">@DateText(trend[0].Session)</text>
                        @if (trend.Count > 1)
                        {
                            <g>
                                <text class="tick" x="@N(ChartWidth)" y="@N(ChartHeight - 4)" text-anchor="end">@DateText(trend[^1].Session)</text>
                            </g>
                        }
                    </svg>

                    @* Each workout's slice of the plot picks it, so a tap anywhere lands on the nearest one. *@
                    <div class="trend-picks" style="left: @N(PlotLeft / ChartWidth * 100)%; width: @N((ChartWidth - PlotLeft) / ChartWidth * 100)%; height: @N(PlotBottom / ChartHeight * 100)%">
                        @foreach (var (session, _) in trend)
                        {
                            <button type="button" aria-pressed="@(session == shown ? "true" : "false")" aria-label="@($"{NameOf(session)}, {DateText(session)}: {PercentText.Format(session.Improvement!.Value)}")"
                                    @onclick="() => picked = session" @onfocus="() => picked = session"></button>
                        }
                    </div>
                </div>
                @if (telemetry)
                {
                    <div class="spread">
                        <p class="label ink">@NameOf(shown!) · @shown!.StartedAt.ToString(Theme.DayFormat, CultureInfo.CurrentCulture)</p>
                        <p class="inline">
                            <Delta Change="shown.Improvement!.Value" />
                            <span class="label">vs last</span>
                        </p>
                    </div>
                }
                else
                {
                    <div class="spread baseline">
                        <p class="body strong">@NameOf(shown!), @shown!.StartedAt.ToString("ddd, MMM d", CultureInfo.CurrentCulture)</p>
                        <p class="inline baseline">
                            <Delta Change="shown.Improvement!.Value" />
                            <span class="note">vs last time</span>
                        </p>
                    </div>
                }
            }
        </section>
        <a class="btn" href="routines">Edit routine</a>

        @if (sessions.Count == 0)
        {
            <p class="note">No finished workouts yet. Each one shows up here after Finish workout.</p>
        }

        @foreach (var month in sessions.GroupBy(s => s.StartedAt.ToString("MMMM yyyy", CultureInfo.CurrentCulture)))
        {
            var editing = editingMonth == month.Key;
            <section class="stack tight" aria-label="@month.Key">
                <div class="spread">
                    <h2 class="month">@month.Key</h2>
                    <button type="button" class="btn-ghost" aria-label="@(editing ? "Done editing" : $"Edit {month.Key}")" @onclick="() => editingMonth = editing ? null : month.Key">@(editing ? "Done" : "Edit")</button>
                </div>
                <div class="ledger">
                    @foreach (var session in month)
                    {
                        var name = NameOf(session);
                        var setCount = setCounts.GetValueOrDefault(session.Id);
                        @* Keyed, so a deleted row's "Delete?" doesn't carry over to the row that takes its place. *@
                        <div class="history-row @(session == shown ? "picked" : "")" @key="session.Id">
                            <span class="caption">@session.StartedAt.ToString("ddd d", CultureInfo.CurrentCulture)</span>
                            <a class="row-text" href="history/@session.Id">
                                <span class="name">@name</span>
                                <span class="caption">@(telemetry ? $"{session.StartedAt.ToString(Theme.DayFormat, CultureInfo.CurrentCulture)} · " : "")@TimeText.Format(session.FinishedAt!.Value - session.StartedAt) · @setCount @(setCount == 1 ? "set" : "sets")</span>
                            </a>
                            @if (editing)
                            {
                                <ConfirmDelete Label="@($"Delete {name} on {session.StartedAt.ToString("MMM d", CultureInfo.CurrentCulture)}")" OnDelete="() => DeleteAsync(session)" />
                            }
                            else if (session.Improvement is { } change)
                            {
                                <Delta Change="change" />
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    // The trend chart's drawing space, which the SVG scales to the page: tick labels at the left, the plot, dates under it.
    private const double ChartWidth = 350, ChartHeight = 168, PlotLeft = 32, PlotTop = 8, PlotBottom = 140;
    private static readonly double[] Steps = [0.01, 0.02, 0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10];

    private bool loaded;
    private List<WorkoutSession> sessions = [];
    private List<(long SessionId, long ExerciseId)> exercisesDone = [];
    private Dictionary<long, int> setCounts = [];
    private Dictionary<long, string> templateNames = [];
    private WorkoutSession? picked;
    private string? editingMonth;

    [CascadingParameter] public Theme Theme { get; set; } = Theme.Logbook;

    protected override async Task OnInitializedAsync()
    {
        await Flow.ScoreSessionsAsync();
        sessions = [.. (await Store.GetSessionsAsync()).Where(s => s.FinishedAt is not null).OrderByDescending(s => s.StartedAt)];
        // Each workout's exercises and how many sets of each: all the trend and the list need, rather than every set ever logged.
        var counts = await Store.GetExerciseSetCountsAsync();
        exercisesDone = [.. counts.Select(c => (c.SessionId, c.ExerciseId))];
        setCounts = counts.GroupBy(c => c.SessionId).ToDictionary(g => g.Key, g => g.Sum(c => c.Sets));
        templateNames = (await Store.GetTemplatesAsync()).ToDictionary(t => t.Id, t => t.Name);
        loaded = true;
    }

    private string NameOf(WorkoutSession session) => session.TemplateId is long id && templateNames.TryGetValue(id, out var name) ? name : "Workout";

    private static string DateText(WorkoutSession session) => session.StartedAt.ToString("MMM d", CultureInfo.CurrentCulture);

    // The y-axis: 5%, 10%, −5%.
    private static string TickText(double tick) => $"{(tick < 0 ? "−" : "")}{Math.Abs(Math.Round(tick * 100, 1)).ToString("0.#", CultureInfo.CurrentCulture)}%";

    // SVG numbers, which take a point whatever the phone's language.
    private static string N(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private async Task DeleteAsync(WorkoutSession session)
    {
        sessions.Remove(session);
        await Flow.DeleteSessionAsync(session);
    }
}
